{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "visitflow/problem v2 — 日历无关的节奏式问题定义",
  "type": "object",
  "required": ["schema", "version", "inputs_hash", "line_id", "cycle",
                "stores", "corridor", "original_assignment_idx", "distance",
                "meta"],
  "properties": {
    "schema": {"const": "visitflow/problem"},
    "version": {"const": "2.0"},
    "inputs_hash": {"type": "string", "pattern": "^sha256:"},
    "line_id": {"type": "string"},
    "cycle": {
      "type": "object",
      "required": ["n_days"],
      "properties": {"n_days": {"type": "integer", "minimum": 1}}
    },
    "stores": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "code", "lon", "lat", "rhythm"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "code": {"type": "string"},
          "lon": {"type": "number"}, "lat": {"type": "number"},
          "rhythm": {
            "type": "object",
            "required": ["period", "phase", "visits_per_period", "ambiguous",
                          "source"],
            "properties": {
              "period": {"type": "integer", "minimum": 1},
              "phase": {"type": "integer", "minimum": 1},
              "visits_per_period": {"type": "integer", "minimum": 1},
              "ambiguous": {"type": "boolean"},
              "source": {"enum": ["explicit", "derived"]}
            }
          }
        }
      }
    },
    "corridor": {
      "type": "object",
      "required": ["min_daily", "max_daily"],
      "properties": {"min_daily": {"type": "integer"},
                      "max_daily": {"type": "integer"}}
    },
    "original_assignment_idx": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "integer"}}
    },
    "distance": {
      "type": "object",
      "required": ["kind", "scope", "matrix_ref", "format", "n",
                    "unreachable_sentinel"],
      "properties": {
        "kind": {"type": "string"},
        "scope": {"const": "per-line"},
        "matrix_ref": {"type": "string", "pattern": "^sha256:"},
        "format": {"const": "npz"},
        "n": {"type": "integer", "minimum": 1},
        "unreachable_sentinel": {"type": "number"}
      }
    },
    "meta": {"type": "object"}
  }
}
