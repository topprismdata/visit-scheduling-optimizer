{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "visitflow/model v1",
  "type": "object",
  "required": ["schema", "version", "problem_hash", "formulation",
                "legal_domain", "feasibility_precheck", "meta"],
  "properties": {
    "schema": {"const": "visitflow/model"},
    "version": {"enum": ["1.0", "1.1"]},
    "problem_hash": {"type": "string", "pattern": "^sha256:"},
    "formulation": {
      "type": "object",
      "required": ["kind", "vars"],
      "properties": {"kind": {"type": "string"}, "vars": {"type": "object"}}
    },
    "legal_domain": {
      "type": "object",
      "required": ["pairs_total", "pairs_available", "fixed"],
      "properties": {"pairs_total": {"type": "integer"},
                      "pairs_legal": {"type": "integer"}, "pairs_available": {"type": "integer"},
                      "fixed": {"type": "integer"}}
    },
    "feasibility_precheck": {
      "type": "object",
      "required": ["capacity_max_ok", "capacity_min_ok", "corridor_ok"],
      "additionalProperties": {"type": ["boolean", "integer"]}
    },
    "meta": {"type": "object"}
  }
}
